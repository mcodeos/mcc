{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "rust: cargo build",
            "type": "shell",
            "command": "cargo",
            "args": ["build"],
            "options": {
                "cwd": "${workspaceFolder}",
                // Build into the editor's own slot, the one rust-analyzer
                // already checks in (`.vscode/settings.json`), so the two warm
                // each other instead of each paying for a cold target dir.
                "env": {
                    "CARGO_TARGET_DIR": "${workspaceFolder}/target/0"
                }
            },
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}