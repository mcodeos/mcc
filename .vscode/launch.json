{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mcc",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/mcc",
            "args": [
                "parse",
                "../mcs/hbl/src/hbl.mc"
            ],
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "rust: cargo build",
            "sourceLanguages": ["rust"]
        }
    ]
}