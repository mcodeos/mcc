# U306 bucket ④: the modern bom overlay face. The slot buys its part at the
# engineering face — key is the instance path relative to the block-header
# top (main -> mic); value is the modern SIP2 counterpart name (the legacy
# `define MICROPHONE.SIP2` description form retired with U267).
bom main {
    mic = MICROPHONE.SIP2_1_25MM_WA
}
