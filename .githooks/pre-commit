#!/usr/bin/env bash
# Pre-commit hook: reject commits that are not English-only (non-ASCII), that
# embed a user-specific absolute path, that carry non-lean code comments, or
# that add an unregistered case-insensitive name comparison.
#
# Installed via `git config core.hooksPath .githooks` so this file is shared
# with every developer who clones the repo (see AGENTS.md).
#
# Checks:
#   1. Staged file contents (added / copied / modified files only) — English only.
#   2. Staged file contents — no home-directory paths (`/Users/<name>/...`).
#   3. Staged `.rs` comments — lean-comments rule (decorative banner rules,
#      change-diary wording, comment lines over 100 columns).
#   4. Staged `.rs` files under `src/` — exact name comparisons only (the
#      registered exemptions are listed in scripts/check-name-case.py).
#   5. Ledger reconciliation, when the staged set touches the mirror — the
#      authoritative table lives in the sibling `mcd` checkout.
#   6. Diagnostic-code reconciliation, when the staged set touches `src/` — a
#      code the spec cites must be declared in errcodes.rs and emitted.
#   (Commit-message checks live in `commit-msg`, which receives the
#    message file path; pre-commit takes no arguments.)
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# ── 1. Staged files: English only ───────────────────────────────────────────
# NUL-separated names keep paths with spaces safe; xargs -0 feeds them to the
# scanner without word splitting.
if ! git diff --cached --name-only --diff-filter=ACM -z \
    | xargs -0 -r python3 "$ROOT/scripts/check-cjk.py"; then
    echo "pre-commit: staged changes contain non-ASCII characters — English only." >&2
    exit 1
fi

# ── 2. Staged files: no user-specific absolute paths ────────────────────────
if ! git diff --cached --name-only --diff-filter=ACM -z \
    | xargs -0 -r python3 "$ROOT/scripts/check-paths.py"; then
    echo "pre-commit: staged changes embed a user-specific absolute path." >&2
    exit 1
fi

# ── 3. Staged `.rs` comments: lean-comments rule ────────────────────────────
# Only *.rs is scanned (the scanner filters by extension), so a staged doc or
# markdown file passes through untouched.
if ! git diff --cached --name-only --diff-filter=ACM -z \
    | xargs -0 -r python3 "$ROOT/scripts/check-comments.py"; then
    echo "pre-commit: staged comments violate the lean-comments rule (AGENTS.md)." >&2
    exit 1
fi

# ── 4. Staged `src/` Rust: exact name comparisons ───────────────────────────
# The scanner filters by extension and by the `src/` prefix, so tests and
# non-Rust files pass through untouched.
if ! git diff --cached --name-only --diff-filter=ACM -z \
    | xargs -0 -r python3 "$ROOT/scripts/check-name-case.py"; then
    echo "pre-commit: staged code adds a case-insensitive name comparison (AGENTS.md)." >&2
    exit 1
fi

# ── 5. Ledger reconciliation: doc table ↔ ATTR_KEYS ─────────────────────────
# The mirror is the only side in this repository; the scanner reports a skip
# when the sibling `mcd` checkout is absent.
if ! git diff --cached --name-only --diff-filter=ACM -z \
    | xargs -0 -r python3 "$ROOT/scripts/check-attr-keys.py"; then
    echo "pre-commit: the ledger doc and ATTR_KEYS disagree (mcd/spec/07-attrs.md)." >&2
    exit 1
fi

# ── 6. Diagnostic-code reconciliation: spec citations ↔ errcodes.rs ─────────
# The scan runs only when the staged set touches `src/`, since that is where a
# code is declared and raised; the catalog lives in this repository, but the
# spec does not, so the scanner reports a skip when the sibling `mcd` checkout
# is absent.
if ! git diff --cached --name-only --diff-filter=ACM -z \
    | xargs -0 -r python3 "$ROOT/scripts/check-errcodes.py"; then
    echo "pre-commit: a cited diagnostic code is stale (mcd/spec/)." >&2
    exit 1
fi

exit 0
